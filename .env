ASTERISK_BRANCH="22.3.0"
ASTERISK_MODULES_ENABLE="EXTRA-SOUNDS-EN-WAV,CORE-SOUNDS-EN-WAV,format_mp3,app_skel,app_saycounted,app_statsd,codec_opus,res_cliexec,res_chan_stats,res_endpoint_stats"
ASTERISK_MODULES_DISABLE="CORE-SOUNDS-EN-GSM"
ASTERISK_CATEGORY_DISABLE="MENUSELECT_TESTS,MENUSELECT_ADDONS"

ASTERISK_USER="asterisk"
ASTERISK_GROUP="asterisk"

ASTERISK_TEMP_ETC_DIR="/tmp/asterisk_conf"

ASTERISK_CACHE_DIR="/var/cache/asterisk"
ASTERISK_ETC_DIR="/etc/asterisk"
ASTERISK_MOD_DIR="/usr/lib/asterisk/modules"
ASTERISK_VARLIB_DIR="/var/lib/asterisk"
ASTERISK_DB_DIR="/var/lib/asterisk"
ASTERISK_KEY_DIR="/var/lib/asterisk"
ASTERISK_DATA_DIR="/var/lib/asterisk"
ASTERISK_AGI_DIR="/var/lib/asterisk/agi-bin"
ASTERISK_POOL_DIR="/var/spool/asterisk"
ASTERISK_RUN_DIR="/var/run/asterisk"
ASTERISK_LOG_DIR="/var/log/asterisk"
ASTERISK_BIN_DIR="/usr/sbin"
